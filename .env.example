# ─── APP ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ─── BASE DE DATOS (Neon) ───────────────────────────────────
DATABASE_URL=postgresql://usuario:password@host/incomer_db?sslmode=require

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=otro_secret_para_refresh
JWT_REFRESH_EXPIRES_IN=7d

# ─── REDIS (Upstash) ─────────────────────────────────────────
REDIS_URL=rediss://usuario:password@host:6379

# ─── STRIPE (modo test) ─────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_aqui_tu_key
STRIPE_WEBHOOK_SECRET=whsec_aqui_tu_webhook

# ─── PAYPAL (sandbox) ───────────────────────────────────────
PAYPAL_CLIENT_ID=aqui_tu_id
PAYPAL_CLIENT_SECRET=aqui_tu_secret

# ─── CLOUDINARY ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=aqui_tu_cloud_name
CLOUDINARY_API_KEY=aqui_tu_key
CLOUDINARY_API_SECRET=aqui_tu_secret

# ─── EMAIL (Resend) ─────────────────────────────────────────
RESEND_API_KEY=re_aqui_tu_key
EMAIL_FROM=noreply@incomer.com